# The address people use to reach Dendrop. Needed for TinyAuth sign-in and secure cookies.
DENDROP_PUBLIC_URL=https://chat.example.com

# Unraid's nobody:users. The container fixes /data ownership and runs as this user.
PUID=99
PGID=100

# --- Sign in with TinyAuth (or any OpenID Connect provider) ---
# In TinyAuth, add an OIDC client with the redirect URL
#   https://chat.example.com/api/auth/oidc/callback
DENDROP_OIDC_ISSUER=
DENDROP_OIDC_CLIENT_ID=
DENDROP_OIDC_CLIENT_SECRET=
# DENDROP_OIDC_NAME=TinyAuth
# DENDROP_OIDC_SCOPES=openid profile email groups
# Members of this group become super admins.
# DENDROP_OIDC_ADMIN_GROUP=admins
# Make an account the first time someone signs in (default true).
# DENDROP_OIDC_AUTO_CREATE=true

# --- Username and password sign-in ---
# On by default so the first (admin) account can be made. Turn off once everyone uses TinyAuth.
# DENDROP_LOCAL_LOGIN=true
# Let anyone make a password account (default false).
# DENDROP_SIGNUP=false

# DENDROP_PORT=8080
# DENDROP_LOG_LEVEL=info
