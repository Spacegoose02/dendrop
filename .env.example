# The address people use to reach Dendrop. Needed for TinyAuth sign-in and secure cookies.
DENDROP_PUBLIC_URL=https://chat.example.com

# Unraid's nobody:users. The container fixes /data ownership and runs as this user.
PUID=99
PGID=100

# --- Sign in with TinyAuth (or any OpenID Connect provider) ---
# In TinyAuth, add an OIDC client with the redirect URL
#   https://chat.example.com/api/auth/oidc/callback
DENDROP_OIDC_ISSUER=
DENDROP_OIDC_CLIENT_ID=
DENDROP_OIDC_CLIENT_SECRET=
# DENDROP_OIDC_NAME=TinyAuth
# DENDROP_OIDC_SCOPES=openid profile email groups
# Members of this group become super admins.
# DENDROP_OIDC_ADMIN_GROUP=admins
# Make an account the first time someone signs in (default true).
# DENDROP_OIDC_AUTO_CREATE=true

# --- Sign in with Google ---
# An OAuth client from Google Cloud with the redirect URI
#   https://chat.example.com/api/auth/google/callback
# See docs/SIGN-IN.md. Who can use it is switched in the app (Instance admin -> Sign-in).
# DENDROP_GOOGLE_CLIENT_ID=
# DENDROP_GOOGLE_CLIENT_SECRET=

# --- Voice and video calls ---
# On, with the LiveKit server built into the image. Browsers reach it through Dendrop's own
# address; audio and video use 7881/tcp and 7882/udp (forward them on your router).
# DENDROP_CALLS=on
# The public IP callers send media to. Empty: found at start-up.
# DENDROP_CALLS_IP=
# DENDROP_CALLS_TCP_PORT=7881
# DENDROP_CALLS_UDP_PORT=7882
# Or use a LiveKit server of your own instead: set all three.
# DENDROP_LIVEKIT_URL=wss://calls.example.com
# DENDROP_LIVEKIT_API_KEY=dendrop
# DENDROP_LIVEKIT_API_SECRET=

# --- Username and password sign-in ---
# On by default so the first (admin) account can be made. Turn off once everyone uses TinyAuth.
# DENDROP_LOCAL_LOGIN=true
# Let anyone make a password account (default false).
# These are starting values: the switches in Instance admin -> Sign-in take over once changed.
# DENDROP_SIGNUP=false

# Largest file a message can carry, in MB (default 25).
# DENDROP_MAX_UPLOAD_MB=25

# Phone notifications go to the Android app's UnifiedPush endpoint (usually ntfy, which uses
# ntfy.sh unless you run your own). They say only "new message" or "incoming call", and are
# encrypted. Allow http:// endpoints for a ntfy server on your home network (default false).
# DENDROP_PUSH_ALLOW_HTTP=false

# iPhone notifications and the iPhone call screen go through Apple (APNs). Make an APNs key in
# the Apple developer account that builds the iOS app (Keys, Apple Push Notifications service),
# put the .p8 file in /data and fill these in. See packages/ios/README.md.
# DENDROP_APNS_KEY_FILE=/data/AuthKey_ABCDE12345.p8
# DENDROP_APNS_KEY_ID=ABCDE12345
# DENDROP_APNS_TEAM_ID=FGHIJ67890
# Only if you changed the iOS app's bundle id:
# DENDROP_APNS_BUNDLE_ID=io.github.spacegoose02.dendrop

# HTTPS without a reverse proxy (see docs/HTTPS.md). Browsers only allow encryption and the
# mic and camera on https://. self-signed: Dendrop makes a certificate in /data/tls (browsers
# warn once per device). Or point at your own certificate and key files.
# DENDROP_HTTPS=self-signed
# DENDROP_TLS_CERT=/data/tls/cert.pem
# DENDROP_TLS_KEY=/data/tls/key.pem

# DENDROP_PORT=8080
# DENDROP_LOG_LEVEL=info
